# Petfinder Custom Pet List Widget configuration
# Generate your widget at:
# https://www.petfinder.com/tools-widgets/custom-pet-list/getting-started/

# Required: JSON array of Petfinder organization IDs from your generated widget code
PETFINDER_ORGANIZATION_IDS=["YOUR_ORG_ID"]

# Optional overrides (defaults match Petfinder's generated widget)
# PETFINDER_SCRIPT_URL=https://www.petfinder.com/pet-scroller.bundle.js
# PETFINDER_API_BASE=https://psl.petfinder.com/graphql
# PETFINDER_S3_URL=https://dbw3zep4prcju.cloudfront.net/
# PETFINDER_URL=https://www.petfinder.com/
# PETFINDER_STATUS=adoptable
# PETFINDER_LIMIT=24
# PETFINDER_HIDE_BREED=false
# PETFINDER_LIST_TITLE=
# PETFINDER_TYPES=["Dog"]
# PETFINDER_AGES=["Young","Adult"]
